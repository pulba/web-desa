---
import MainLayout from "../layouts/MainLayout.astro";
import Container from "../components/Container.astro";
---

<MainLayout title="Dasar Hukum PPID | Desa Makmur">
    <section class="py-20 bg-slate-50 min-h-screen">
        <Container>
            <div class="max-w-4xl mx-auto">
                <a
                    href="/ppid"
                    class="inline-flex items-center text-primary-600 hover:text-primary-700 font-bold mb-8 transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 mr-2"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                            clip-rule="evenodd"></path>
                    </svg>
                    Kembali ke Layanan PPID
                </a>

                <div
                    class="bg-white rounded-3xl shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] overflow-hidden border border-slate-100"
                >
                    <div
                        class="p-8 md:p-12 border-b border-primary-100 bg-primary-50/50"
                    >
                        <div
                            class="inline-block bg-primary-100 text-primary-700 px-4 py-1.5 rounded-full text-xs font-black tracking-widest uppercase mb-4"
                        >
                            Regulasi
                        </div>
                        <h1
                            class="text-3xl md:text-5xl font-black text-slate-800 mb-4 tracking-tight"
                        >
                            DASAR HUKUM
                        </h1>
                        <p
                            class="text-slate-600 text-lg md:text-xl font-medium max-w-2xl leading-relaxed"
                        >
                            Yang mendasari pembentukan Pejabat Pengelola
                            Informasi dan Dokumentasi (PPID)
                        </p>
                    </div>

                    <div class="p-8 md:p-12 space-y-12">
                        <!-- Undang Undang Republik Indonesia -->
                        <div class="space-y-6">
                            <h2
                                class="text-2xl font-bold text-slate-800 flex items-center"
                            >
                                <span
                                    class="w-10 h-10 rounded-xl bg-primary-100 text-primary-600 flex items-center justify-center text-lg mr-4 shadow-sm border border-primary-200"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-5 w-5"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.617a1 1 0 01.894-1.788l1.599.799L9 4.323V3a1 1 0 011-1zm-5 8.274l-.818 2.552c.25.112.526.174.818.174.292 0 .569-.062.818-.174L5 10.274zm10 0l-.818 2.552c.25.112.526.174.818.174.292 0 .569-.062.818-.174L15 10.274z"
                                            clip-rule="evenodd"></path>
                                    </svg>
                                </span>
                                Undang-Undang Republik Indonesia
                            </h2>
                            <ul class="space-y-4 pl-[3.5rem]">
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-primary-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Undang-Undang Nomor 14 Tahun 2008
                                        tentang Keterbukaan Informasi Publik</span
                                    >
                                </li>
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-primary-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Undang-Undang Nomor 25 Tahun 2009
                                        tentang Pelayanan Publik</span
                                    >
                                </li>
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-primary-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Undang-Undang Nomor 6 Tahun 2014
                                        tentang Desa</span
                                    >
                                </li>
                            </ul>
                        </div>

                        <!-- Peraturan Pemerintah -->
                        <div class="space-y-6">
                            <h2
                                class="text-2xl font-bold text-slate-800 flex items-center"
                            >
                                <span
                                    class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-lg mr-4 shadow-sm border border-emerald-200"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-5 w-5"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2h-1.528A6 6 0 004 9.528V4zm3 8a4 4 0 100 8 4 4 0 000-8z"
                                            clip-rule="evenodd"></path>
                                    </svg>
                                </span>
                                Peraturan Pemerintah
                            </h2>
                            <ul class="space-y-4 pl-[3.5rem]">
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-emerald-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Peraturan Pemerintah Nomor 61 Tahun
                                        2010 Tentang Pelaksanaan Undang-Undang
                                        Nomor 14 Tahun 2008 tentang Keterbukaan
                                        Informasi Publik</span
                                    >
                                </li>
                            </ul>
                        </div>

                        <!-- Peraturan Komisi Informasi -->
                        <div class="space-y-6">
                            <h2
                                class="text-2xl font-bold text-slate-800 flex items-center"
                            >
                                <span
                                    class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-lg mr-4 shadow-sm border border-blue-200"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-5 w-5"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                    >
                                        <path
                                            d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"
                                        ></path>
                                        <path
                                            fill-rule="evenodd"
                                            d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z"
                                            clip-rule="evenodd"></path>
                                    </svg>
                                </span>
                                Peraturan Komisi Informasi
                            </h2>
                            <ul class="space-y-4 pl-[3.5rem]">
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-blue-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Peraturan Komisi Informasi Pusat
                                        Republik Indonesia Nomor 1 Tahun 2010
                                        tentang Standar Layanan Informasi Publik</span
                                    >
                                </li>
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-blue-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Peraturan Komisi Informasi Pusat
                                        Republik Indonesia Nomor 1 Tahun 2013
                                        tentang Prosedur Penyelesaian Sengketa
                                        Informasi Publik</span
                                    >
                                </li>
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-blue-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Peraturan Komisi Informasi Pusat
                                        Republik Indonesia Nomor 1 Tahun 2017
                                        tentang Pengklasifikasian Informasi
                                        Publik</span
                                    >
                                </li>
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-blue-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Peraturan Komisi Informasi Pusat
                                        Republik Indonesia Nomor 1 Tahun 2018
                                        tentang Standar Layanan Informasi Publik
                                        Desa</span
                                    >
                                </li>
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-blue-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Peraturan Komisi Informasi Pusat
                                        Republik Indonesia Nomor 1 Tahun 2021
                                        tentang Standar Layanan Informasi Publik</span
                                    >
                                </li>
                            </ul>
                        </div>

                        <!-- Peraturan Menteri Dalam Negeri -->
                        <div class="space-y-6">
                            <h2
                                class="text-2xl font-bold text-slate-800 flex items-center"
                            >
                                <span
                                    class="w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center text-lg mr-4 shadow-sm border border-orange-200"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-5 w-5"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                    >
                                        <path
                                            d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 8.56l-1.221.524a1 1 0 000 1.838l7 3a1 1 0 00.788 0l7-3a1 1 0 000-1.838l-1.219-.524-1.018.436a1 1 0 01-1.02-.001L10 6.645 5.56 8.544l-1.23.528A1 1 0 013.31 8.56z"
                                        ></path>
                                        <path
                                            d="M12.913 13.905l.432-1.306A5.968 5.968 0 0013.5 10a6 6 0 10-12 0c0 1.258.388 2.427 1.055 3.393l1.109 4.436A1 1 0 004.634 19h10.732a1 1 0 00.97-1.243l-3.423-3.852zM10 14a4 4 0 110-8 4 4 0 010 8z"
                                        ></path>
                                    </svg>
                                </span>
                                Peraturan Menteri Dalam Negeri
                            </h2>
                            <ul class="space-y-4 pl-[3.5rem]">
                                <li
                                    class="flex items-start text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-primary-200 hover:shadow-sm transition-all text-sm md:text-base leading-relaxed"
                                >
                                    <span class="mr-3 text-orange-500 mt-0.5"
                                        >•</span
                                    >
                                    <span
                                        >Peraturan Pemerintah Nomor 61 Tahun
                                        2010 Tentang Pelaksanaan Undang-Undang
                                        Nomor 14 Tahun 2008 tentang Keterbukaan
                                        Informasi Publik</span
                                    >
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </Container>
    </section>
</MainLayout>
