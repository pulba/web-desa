---
import MainLayout from "../layouts/MainLayout.astro";
import Container from "../components/Container.astro";

const infographicLinks = [
    { id: "idm", label: "IDM", desc: "Indeks Desa Membangun", icon: "📊" },
    {
        id: "apbdes",
        label: "APBDes",
        desc: "Anggaran & Belanja Desa",
        icon: "💰",
    },
    {
        id: "penduduk",
        label: "Penduduk",
        desc: "Demografi Kependudukan",
        icon: "👥",
    },
    {
        id: "stunting",
        label: "Stunting",
        desc: "Data Prevalensi Stunting",
        icon: "👶",
    },
    { id: "sdgs", label: "SDGs", desc: "Pencapaian SDGs Desa", icon: "🌍" },
    {
        id: "bansos",
        label: "Bansos",
        desc: "Penyaluran Bantuan Sosial",
        icon: "🤝",
    },
];
---

<MainLayout title="Infografis Desa - Pusat Data & Statistik">
    <!-- Hero Section -->
    <section
        class="relative pt-32 pb-20 bg-slate-900 overflow-hidden border-b border-white/10"
    >
        <!-- Background Effects -->
        <div class="absolute inset-0 z-0">
            <div
                class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_20%_30%,rgba(59,130,246,0.15),transparent_50%)]"
            >
            </div>
            <div
                class="absolute bottom-0 right-0 w-full h-full bg-[radial-gradient(circle_at_80%_70%,rgba(16,185,129,0.1),transparent_50%)]"
            >
            </div>
            <div
                class="absolute inset-0 opacity-20"
                style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 40px 40px;"
            >
            </div>
        </div>

        <Container className="relative z-10">
            <div class="max-w-3xl animate-fade-in">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-500/10 border border-primary-500/20 text-primary-400 text-[10px] font-black uppercase tracking-widest mb-6"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"
                        ></span>
                    </span>
                    Transparansi Data Desa
                </div>
                <h1
                    class="text-4xl md:text-6xl font-black text-white leading-[1.1] tracking-tight mb-6"
                >
                    Pusat <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-emerald-400"
                        >Statistik & Infografis</span
                    >
                </h1>
                <p
                    class="text-slate-400 text-lg md:text-xl font-medium mb-10 max-w-2xl leading-relaxed"
                >
                    Data akurat dan transparan mengenai perkembangan Desa
                    Makmur. Kami berkomitmen menyajikan informasi publik yang
                    mudah diakses oleh seluruh warga.
                </p>
            </div>

            <!-- Submenu Navigation -->
            <div
                class="mt-16 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 animate-fade-in-up"
                style="animation-delay: 300ms;"
            >
                {
                    infographicLinks.map((link) => (
                        <a
                            href={`/infografis/${link.id}`}
                            class="p-4 rounded-xl text-center bg-white/5 border border-white/10 backdrop-blur hover:bg-white/10 hover:border-primary-400/50 transition-all group"
                        >
                            <div class="text-2xl mb-2 group-hover:-translate-y-1 transition-transform">
                                {link.icon}
                            </div>
                            <div class="text-xs font-bold text-white uppercase tracking-widest mb-1">
                                {link.label}
                            </div>
                            <div class="text-[10px] text-slate-400 font-medium line-clamp-1 group-hover:text-primary-300 transition-colors">
                                {link.desc}
                            </div>
                        </a>
                    ))
                }
            </div>
        </Container>
    </section>

    <!-- Hub Content -->
    <div class="bg-slate-50 py-24">
        <Container>
            <div class="max-w-4xl mx-auto text-center">
                <div
                    class="inline-block px-4 py-1.5 bg-primary-50 text-primary-700 text-[10px] font-black uppercase tracking-wider rounded-lg mb-4 border border-primary-100"
                >
                    Kategori Informasi
                </div>
                <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-6">
                    Pilih Kategori Data
                </h2>
                <p class="text-slate-500 text-lg mb-12 max-w-2xl mx-auto">
                    Klik pada salah satu kategori di atas untuk melihat
                    visualisasi data mendalam mengenai berbagai aspek
                    pembangunan dan kemasyarakatan Desa Makmur.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
                    <div
                        class="bg-white p-10 rounded-[2.5rem] border border-slate-100 shadow-sm hover:shadow-xl hover:shadow-primary-100/30 transition-all group"
                    >
                        <div
                            class="w-16 h-16 bg-primary-50 text-primary-600 rounded-2xl flex items-center justify-center text-3xl mb-8 group-hover:scale-110 transition-transform"
                        >
                            📈
                        </div>
                        <h3
                            class="text-2xl font-black text-slate-900 mb-4 tracking-tight"
                        >
                            Transparansi Publik
                        </h3>
                        <p class="text-slate-500 leading-relaxed font-medium">
                            Penyajian data ini adalah bentuk komitmen Pemerintah
                            Desa dalam keterbukaan informasi guna mewujudkan
                            tata kelola desa yang baik dan akuntabel.
                        </p>
                    </div>
                    <div
                        class="bg-white p-10 rounded-[2.5rem] border border-slate-100 shadow-sm hover:shadow-xl hover:shadow-blue-100/30 transition-all group"
                    >
                        <div
                            class="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-3xl mb-8 group-hover:scale-110 transition-transform"
                        >
                            📱
                        </div>
                        <h3
                            class="text-2xl font-black text-slate-900 mb-4 tracking-tight"
                        >
                            Akses Mudah
                        </h3>
                        <p class="text-slate-500 leading-relaxed font-medium">
                            Data diperbarui secara berkala dan dioptimalkan
                            untuk akses melalui perangkat mobile sehingga warga
                            dapat memantau perkembangan desa kapan saja di mana
                            saja.
                        </p>
                    </div>
                </div>
            </div>
        </Container>
    </div>
</MainLayout>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    @keyframes fade-in-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fade-in 0.8s ease-out forwards;
    }
    .animate-fade-in-up {
        opacity: 0;
        animation: fade-in-up 0.8s ease-out forwards;
    }
</style>
