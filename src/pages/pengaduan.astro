---
import MainLayout from "../layouts/MainLayout.astro";
import Container from "../components/Container.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { getCollection, getEntry } from "astro:content";

// Fetch settings for WA number
const settingsEntry = await getEntry("settings", "main");
const waLayanan = settingsEntry?.data?.whatsappLayanan || settingsEntry?.data?.phone || "081234567890";

// Fetch pengaduan data
const allPengaduan = await getCollection("pengaduan");

// Sort by date descending
const sortedPengaduan = allPengaduan.sort(
    (a, b) => new Date(b.data.tanggal).getTime() - new Date(a.data.tanggal).getTime()
);

// Format date helper
const formatDate = (dateString) => {
    const date = new Date(dateString);
    return date.toLocaleDateString("id-ID", {
        day: "numeric",
        month: "long",
        year: "numeric"
    });
};

const getStatusColor = (status) => {
    switch (status) {
        case "Selesai": return "bg-green-100 text-green-700";
        case "Dijawab": return "bg-blue-100 text-blue-700";
        default: return "bg-orange-100 text-orange-700";
    }
};
---

<MainLayout title="Pengaduan Masyarakat" description="Layanan Pengaduan Masyarakat Desa Makmur terpadu.">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-primary-700 via-primary-600 to-primary-800 py-24 overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-0 left-0 w-72 h-72 bg-white rounded-full -translate-x-1/2 -translate-y-1/2"></div>
            <div class="absolute bottom-0 right-0 w-96 h-96 bg-white rounded-full translate-x-1/3 translate-y-1/3"></div>
        </div>
        <Container className="relative z-10 text-center">
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 tracking-tight">
                Layanan <span class="text-primary-200">Pengaduan</span>
            </h1>
            <p class="text-primary-100 text-lg max-w-2xl mx-auto leading-relaxed">
                Suara Anda penting bagi kami. Pantau riwayat tanggapan dan tindak lanjut dari laporan masyarakat Desa Makmur.
            </p>
        </Container>
    </section>

    <!-- Main Content -->
    <section class="py-16 bg-slate-50 min-h-screen">
        <Container>
            <div class="max-w-4xl mx-auto">
                <!-- Filter Section -->
                <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 mb-8 flex flex-col md:flex-row gap-4 items-center justify-between transition-colors">
                    <div class="flex items-center gap-3 w-full md:w-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        <span class="font-bold text-slate-700 dark:text-slate-300 transition-colors">Filter Pencarian:</span>
                    </div>
                    
                    <div class="flex flex-wrap gap-3 w-full md:w-auto">
                        <select id="filter-tanggal" class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm rounded-xl focus:ring-primary-500 focus:border-primary-500 block p-2.5 outline-none font-medium transition-colors">
                            <option value="">Semua Tanggal</option>
                            {[...Array(31)].map((_, i) => (
                                <option value={String(i + 1).padStart(2, '0')}>{i + 1}</option>
                            ))}
                        </select>
                        <select id="filter-bulan" class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm rounded-xl focus:ring-primary-500 focus:border-primary-500 block p-2.5 outline-none font-medium transition-colors">
                            <option value="">Semua Bulan</option>
                            <option value="01">Januari</option>
                            <option value="02">Februari</option>
                            <option value="03">Maret</option>
                            <option value="04">April</option>
                            <option value="05">Mei</option>
                            <option value="06">Juni</option>
                            <option value="07">Juli</option>
                            <option value="08">Agustus</option>
                            <option value="09">September</option>
                            <option value="10">Oktober</option>
                            <option value="11">November</option>
                            <option value="12">Desember</option>
                        </select>
                        <select id="filter-tahun" class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm rounded-xl focus:ring-primary-500 focus:border-primary-500 block p-2.5 outline-none font-medium transition-colors">
                            <option value="">Semua Tahun</option>
                            <option value="2024">2024</option>
                            <option value="2023">2023</option>
                        </select>
                        <button id="reset-filter" class="px-4 py-2.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 font-bold rounded-xl text-sm transition-colors">
                            Reset
                        </button>
                    </div>
                </div>

                <!-- Chat Layout Container -->
                <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-xl overflow-hidden border border-slate-200 dark:border-slate-700 transition-colors">
                    <!-- Chat Header -->
                    <div class="bg-slate-100/50 dark:bg-slate-900/50 px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-sm">
                                💬
                            </div>
                            <div>
                                <h2 class="font-bold text-slate-900 dark:text-white leading-tight transition-colors">Riwayat Publik</h2>
                                <p class="text-xs text-slate-500 dark:text-slate-400 font-medium transition-colors">Aspirasi & Laporan Masuk</p>
                            </div>
                        </div>
                        <div class="text-xs font-bold text-slate-400 dark:text-slate-500 bg-white dark:bg-slate-800 px-3 py-1 rounded-full border border-slate-200 dark:border-slate-700 shadow-sm transition-colors">
                            <span id="result-count">{sortedPengaduan.length}</span> Laporan
                        </div>
                    </div>

                    <!-- Chat Interface (Body) -->
                    <div class="p-6 h-[600px] overflow-y-auto space-y-8 bg-[url('/pattern-light.svg')] bg-repeat" id="chat-container">
                        {
                            sortedPengaduan.map((item) => {
                                const dateObj = new Date(item.data.tanggal);
                                const dTanggal = String(dateObj.getDate()).padStart(2, '0');
                                const dBulan = String(dateObj.getMonth() + 1).padStart(2, '0');
                                const dTahun = String(dateObj.getFullYear());

                                return (
                                    <div 
                                        class="chat-group"
                                        data-tanggal={dTanggal}
                                        data-bulan={dBulan}
                                        data-tahun={dTahun}
                                    >
                                        <!-- User Message (Left) -->
                                        <div class="flex flex-col items-start max-w-[85%] mb-4">
                                            <div class="flex items-end gap-2 mb-1 pl-2">
                                                <span class="text-xs font-bold text-slate-600 dark:text-slate-400 mt-2 transition-colors">{item.data.nama}</span>
                                                <span class="text-[10px] text-slate-400 dark:text-slate-500 font-medium mt-2 transition-colors">{formatDate(item.data.tanggal)}</span>
                                            </div>
                                            <div class="bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 px-5 py-3.5 rounded-2xl rounded-tl-sm shadow-sm transition-colors">
                                                <p class="text-sm leading-relaxed whitespace-pre-line">{item.data.pesan}</p>
                                            </div>
                                            <div class="mt-2 pl-2">
                                                <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${getStatusColor(item.data.status)}`}>
                                                    {item.data.status}
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Admin Response (Right) -->
                                        {item.data.jawabanAdmin && (
                                            <div class="flex flex-col items-end max-w-[85%] ml-auto mt-2">
                                                <div class="flex items-end gap-2 mb-1 pr-2">
                                                    <span class="text-[10px] text-slate-400 dark:text-slate-500 font-medium transition-colors">{formatDate(item.data.tanggal)}</span>
                                                    <span class="text-xs font-bold text-primary-700 dark:text-primary-400 transition-colors">Pemerintah Desa</span>
                                                </div>
                                                <div class="bg-primary-50 dark:bg-primary-900/30 border border-primary-200 dark:border-primary-800/50 text-slate-800 dark:text-slate-200 px-5 py-3.5 rounded-2xl rounded-tr-sm shadow-sm relative transition-colors">
                                                    <!-- Tail pointer -->
                                                    <div class="absolute top-0 -right-2 w-4 h-4 bg-primary-50 dark:bg-primary-900/40 border-t border-r border-primary-200 dark:border-primary-800/50 transform rotate-45 translate-y-2 -z-10 transition-colors"></div>
                                                    <p class="text-sm leading-relaxed whitespace-pre-line">{item.data.jawabanAdmin}</p>
                                                </div>
                                            </div>
                                        )}
                                    </div>
                                )
                            })
                        }

                        {sortedPengaduan.length === 0 && (
                            <div class="flex flex-col items-center justify-center h-full text-slate-400 gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                </svg>
                                <p class="font-medium text-sm">Belum ada riwayat pengaduan.</p>
                            </div>
                        )}
                        
                        <!-- Empty Search Message (Hidden properly via JS initially) -->
                        <div id="no-results-msg" class="hidden flex-col items-center justify-center h-full text-slate-500 gap-3 pt-12 pb-12">
                            <h3 class="font-bold text-lg">Pencarian Tidak Ditemukan</h3>
                            <p class="text-sm">Tidak ada pengaduan yang sesuai dengan filter waktu yang dipilih.</p>
                        </div>
                    </div>

                    <!-- Chat Input Form -->
                    <div class="bg-white dark:bg-slate-850 border-t border-slate-200 dark:border-slate-800 p-4 md:p-6 pb-6 md:pb-8 transition-colors">
                        <form id="form-pengaduan" class="flex flex-col md:flex-row gap-4 items-end">
                            <div class="flex-1 w-full space-y-3">
                                <input type="text" id="input-nama" required placeholder="Nama Lengkap Anda" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-primary-500 focus:outline-none transition-all text-sm font-medium" />
                                <textarea id="input-pesan" required rows="2" placeholder="Tuliskan isi laporan atau pengaduan Anda di sini..." class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 focus:ring-2 focus:ring-primary-500 focus:outline-none transition-all text-sm resize-none"></textarea>
                            </div>
                            <div class="w-full md:w-auto">
                                <button type="submit" class="w-full md:w-auto px-8 py-3 h-[52px] bg-primary-600 hover:bg-primary-700 text-white font-bold rounded-xl shadow-lg shadow-primary-200 transition-all flex items-center justify-center gap-2">
                                    <span>Kirim</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform -rotate-45 -mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                                    </svg>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </Container>
    </section>

    <!-- Data for JS -->
    <div id="wa-data" data-wa={waLayanan} class="hidden"></div>

    <!-- Filter Logic Script -->
    <script is:inline>
        document.addEventListener("astro:page-load", initPengaduanFilter);
        document.addEventListener("DOMContentLoaded", initPengaduanFilter);

        function initPengaduanFilter() {
            const filterTanggal = document.getElementById("filter-tanggal");
            const filterBulan = document.getElementById("filter-bulan");
            const filterTahun = document.getElementById("filter-tahun");
            const resetBtn = document.getElementById("reset-filter");
            const chatGroups = document.querySelectorAll(".chat-group");
            const noResultsMsg = document.getElementById("no-results-msg");
            const resultCountSpan = document.getElementById("result-count");

            if (!filterTanggal) return; // Prevent errors if not on the page

            function applyFilter() {
                const valTanggal = filterTanggal.value;
                const valBulan = filterBulan.value;
                const valTahun = filterTahun.value;
                
                let visibleCount = 0;

                chatGroups.forEach(group => {
                    const groupTanggal = group.getAttribute("data-tanggal");
                    const groupBulan = group.getAttribute("data-bulan");
                    const groupTahun = group.getAttribute("data-tahun");

                    const matchTanggal = valTanggal === "" || groupTanggal === valTanggal;
                    const matchBulan = valBulan === "" || groupBulan === valBulan;
                    const matchTahun = valTahun === "" || groupTahun === valTahun;

                    if (matchTanggal && matchBulan && matchTahun) {
                        group.style.display = "block";
                        visibleCount++;
                    } else {
                        group.style.display = "none";
                    }
                });

                // Update counter
                if (resultCountSpan) {
                    resultCountSpan.innerText = visibleCount;
                }

                // Show/Hide no results message
                if (visibleCount === 0 && chatGroups.length > 0) {
                    noResultsMsg.style.display = "flex";
                } else if (noResultsMsg) {
                    noResultsMsg.style.display = "none";
                }
            }

            // Bind Events
            filterTanggal.addEventListener("change", applyFilter);
            filterBulan.addEventListener("change", applyFilter);
            filterTahun.addEventListener("change", applyFilter);

            resetBtn.addEventListener("click", () => {
                filterTanggal.value = "";
                filterBulan.value = "";
                filterTahun.value = "";
                applyFilter();
            });
            
            // Initial Call
            applyFilter();
            
            // Scroll to bottom of chat initially
            const chatContainer = document.getElementById("chat-container");
            if(chatContainer) {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            // Form Submission Simulation
            const formPengaduan = document.getElementById("form-pengaduan");
            if (formPengaduan) {
                formPengaduan.addEventListener("submit", (e) => {
                    e.preventDefault();
                    
                    const nama = document.getElementById("input-nama").value;
                    const pesan = document.getElementById("input-pesan").value;
                    
                    if (!nama || !pesan) return;

                    const dateObj = new Date();
                    const dTanggal = String(dateObj.getDate()).padStart(2, '0');
                    const dBulan = String(dateObj.getMonth() + 1).padStart(2, '0');
                    const dTahun = String(dateObj.getFullYear());
                    
                    const formatOptions = { day: 'numeric', month: 'long', year: 'numeric' };
                    const formattedDate = dateObj.toLocaleDateString('id-ID', formatOptions);

                    // Create New Bubble DOM
                    const newBubble = document.createElement("div");
                    newBubble.className = "chat-group";
                    newBubble.setAttribute("data-tanggal", dTanggal);
                    newBubble.setAttribute("data-bulan", dBulan);
                    newBubble.setAttribute("data-tahun", dTahun);
                    
                    newBubble.innerHTML = `
                        <div class="flex flex-col items-start max-w-[85%] mb-4 opacity-0 transition-opacity duration-500" id="new-bubble-anim">
                            <div class="flex items-end gap-2 mb-1 pl-2">
                                <span class="text-xs font-bold text-slate-600">${nama}</span>
                                <span class="text-[10px] text-slate-400 font-medium">${formattedDate}</span>
                            </div>
                            <div class="bg-white border border-slate-200 text-slate-700 px-5 py-3.5 rounded-2xl rounded-tl-sm shadow-sm">
                                <p class="text-sm leading-relaxed whitespace-pre-line">${pesan}</p>
                            </div>
                            <div class="mt-2 pl-2">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-orange-100 text-orange-700">
                                    Menunggu
                                </span>
                            </div>
                        </div>
                    `;

                    // Hide empty message if visible
                    if (noResultsMsg) noResultsMsg.style.display = "none";
                    
                    // Insert at bottom of the chat list, right before the empty msg div
                    chatContainer.insertBefore(newBubble, noResultsMsg);

                    // Re-apply filter so UI updates correctly
                    applyFilter();

                    // Animate in
                    setTimeout(() => {
                        const animTarget = newBubble.querySelector("#new-bubble-anim");
                        if(animTarget) animTarget.classList.remove("opacity-0");
                        chatContainer.scrollTo({ top: chatContainer.scrollHeight, behavior: 'smooth' });
                    }, 50);

                    // Clean form & notify
                    formPengaduan.reset();
                    
                    setTimeout(() => {
                        // Extract and clean up WhatsApp number
                        const waDataNode = document.getElementById("wa-data");
                        const rawNumber = waDataNode ? waDataNode.getAttribute("data-wa") : "081234567890";
                        
                        let cleanNumber = rawNumber.replace(/\D/g, ""); // Remove non-digits
                        if (cleanNumber.startsWith("0")) {
                            cleanNumber = "62" + cleanNumber.substring(1);
                        } else if (!cleanNumber.startsWith("62")) {
                            cleanNumber = "62" + cleanNumber;
                        }

                        // Prepare WA text
                        const waText = `Halo Pemerintah Desa Makmur,%0A%0ASaya ingin menyampaikan pengaduan:%0A*Nama:* ${encodeURIComponent(nama)}%0A*Laporan:* ${encodeURIComponent(pesan)}%0A%0ATerima kasih.`;
                        const waUrl = `https://wa.me/${cleanNumber}?text=${waText}`;

                        // Open WA in a new tab
                        window.open(waUrl, "_blank");

                    }, 500);
                });
                
                // --- CROSS-PAGE ROUTING FROM SPEED DIAL ---
                const pendingData = localStorage.getItem("pendingPengaduan");
                if (pendingData) {
                    try {
                        const data = JSON.parse(pendingData);
                        localStorage.removeItem("pendingPengaduan"); // Clear so it only runs once
                        
                        const inputNama = document.getElementById("input-nama");
                        const inputPesan = document.getElementById("input-pesan");
                        
                        if (inputNama && inputPesan && data.nama && data.pesan) {
                            inputNama.value = data.nama;
                            inputPesan.value = data.pesan;
                            
                            // Let the page render beautifully first, then auto-submit the form
                            setTimeout(() => {
                                formPengaduan.dispatchEvent(new Event("submit", { cancelable: true, bubbles: true }));
                            }, 500);
                        }
                    } catch(e) {
                        console.error("Failed parsing pending pengaduan", e);
                    }
                }
            }
        }
    </script>
</MainLayout>
