---
import MainLayout from "../../layouts/MainLayout.astro";
import Container from "../../components/Container.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import Button from "../../components/Button.astro";
import { getCollection, getEntry } from "astro:content";

const allUMKM = await getCollection("umkm");

// Read categories from settings
const settingsEntry = await getEntry("settings", "main");
const kategoriUMKM = settingsEntry?.data?.kategoriUMKM || [
    "Makanan",
    "Kerajinan",
    "Pertanian",
    "Minuman",
];
const categories = ["Semua", ...kategoriUMKM];

// Get price range
const prices = allUMKM.map((p) => p.data.price);
const minPrice = prices.length > 0 ? Math.min(...prices) : 0;
const maxPrice = prices.length > 0 ? Math.max(...prices) : 1000000;
---

<MainLayout title="Belanja Desa">
    <!-- Hero Section -->
    <section
        class="relative bg-gradient-to-br from-primary-700 via-primary-600 to-primary-800 py-24 overflow-hidden"
    >
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-10">
            <div
                class="absolute top-0 left-0 w-72 h-72 bg-white rounded-full -translate-x-1/2 -translate-y-1/2"
            >
            </div>
            <div
                class="absolute bottom-0 right-0 w-96 h-96 bg-white rounded-full translate-x-1/3 translate-y-1/3"
            >
            </div>
            <div
                class="absolute top-1/2 left-1/2 w-48 h-48 bg-white rounded-full -translate-x-1/2 -translate-y-1/2"
            >
            </div>
        </div>
        <!-- Floating Icons -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div
                class="absolute top-16 left-[10%] text-white/10 text-6xl animate-float-slow"
            >
                🛍️
            </div>
            <div
                class="absolute top-28 right-[15%] text-white/10 text-5xl animate-float-medium"
            >
                🧺
            </div>
            <div
                class="absolute bottom-12 left-[20%] text-white/10 text-4xl animate-float-fast"
            >
                🌾
            </div>
            <div
                class="absolute bottom-20 right-[25%] text-white/10 text-5xl animate-float-slow"
            >
                🍳
            </div>
        </div>
        <Container className="relative z-10 text-center">
            <h1
                class="text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight"
            >
                Belanja <span class="text-primary-200">Desa</span>
            </h1>
            <p
                class="text-primary-100 text-lg max-w-2xl mx-auto leading-relaxed"
            >
                Katalog produk unggulan UMKM Desa Makmur. Belanja langsung dari
                pengrajin dan petani kami untuk memajukan ekonomi lokal.
            </p>
        </Container>
    </section>

    <section class="section-padding">
        <Container>
            <div class="flex flex-col lg:flex-row gap-12">
                <!-- Mobile Filter Toggle -->
                <button
                    id="mobile-filter-toggle"
                    class="lg:hidden flex items-center justify-center gap-2 w-full py-3 bg-white border border-slate-200 rounded-2xl text-sm font-bold text-slate-700 hover:border-primary-500 hover:text-primary-600 transition-all shadow-sm"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
                        ></path>
                    </svg>
                    Filter & Kategori
                    <span
                        id="active-filter-badge"
                        class="hidden px-2 py-0.5 bg-primary-100 text-primary-700 rounded-full text-[10px] font-bold"
                        >0</span
                    >
                </button>

                <!-- Sidebar Filter -->
                <aside
                    id="filter-sidebar"
                    class="lg:w-64 shrink-0 space-y-8 hidden lg:block"
                >
                    <!-- Kategori -->
                    <div
                        class="bg-white rounded-2xl border border-slate-100 p-6 shadow-sm"
                    >
                        <h3
                            class="font-bold text-slate-900 mb-4 flex items-center text-sm uppercase tracking-wider"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4 mr-2 text-primary-600"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                                ></path>
                            </svg>
                            Kategori
                        </h3>
                        <div class="space-y-1" id="category-filters">
                            {
                                categories.map((cat, i) => (
                                    <button
                                        data-category={cat}
                                        class={`category-btn w-full text-left px-4 py-2.5 rounded-xl text-sm font-medium transition-all ${i === 0 ? "bg-primary-50 text-primary-700 font-bold" : "text-slate-600 hover:bg-slate-50 hover:text-primary-600"}`}
                                    >
                                        {cat}
                                    </button>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Rentang Harga -->
                    <div
                        class="bg-white rounded-2xl border border-slate-100 p-6 shadow-sm"
                    >
                        <h3
                            class="font-bold text-slate-900 mb-4 flex items-center text-sm uppercase tracking-wider"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4 mr-2 text-primary-600"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                            Rentang Harga
                        </h3>
                        <div class="space-y-4">
                            <input
                                id="price-range"
                                type="range"
                                min={minPrice}
                                max={maxPrice}
                                value={maxPrice}
                                step="5000"
                                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-primary-600"
                            />
                            <div class="flex justify-between text-xs font-bold">
                                <span class="text-slate-400"
                                    >Rp{minPrice.toLocaleString("id-ID")}</span
                                >
                                <span
                                    id="price-display"
                                    class="text-primary-600 bg-primary-50 px-2 py-0.5 rounded-lg"
                                >
                                    Maks: Rp{maxPrice.toLocaleString("id-ID")}
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- CTA -->
                    <div
                        class="bg-gradient-to-br from-primary-600 to-primary-700 rounded-2xl p-6 text-white relative overflow-hidden"
                    >
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"
                        >
                        </div>
                        <h4 class="font-bold mb-2 relative z-10">
                            Ingin Berjualan?
                        </h4>
                        <p class="text-xs text-primary-100 mb-4 relative z-10">
                            Warga Desa Makmur dapat mendaftarkan produk UMKM-nya
                            di sini secara gratis.
                        </p>
                        <a
                            href="/kontak"
                            class="relative z-10 block w-full py-2.5 bg-white text-primary-600 rounded-xl text-xs font-bold hover:bg-primary-50 transition-colors uppercase text-center shadow-lg shadow-primary-900/20"
                            >Hubungi Pengelola</a
                        >
                    </div>
                </aside>

                <!-- Product Grid -->
                <div class="flex-grow">
                    <div class="flex items-center justify-between mb-8">
                        <p class="text-sm text-slate-500">
                            Menampilkan <span
                                id="product-count"
                                class="font-bold text-slate-900"
                                >{allUMKM.length}</span
                            > produk
                        </p>
                        <select
                            id="sort-select"
                            class="text-sm bg-white border border-slate-200 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-primary-500 font-medium cursor-pointer"
                        >
                            <option value="default">Terbaru</option>
                            <option value="price-asc">Harga Terendah</option>
                            <option value="price-desc">Harga Tertinggi</option>
                            <option value="name-asc">A - Z</option>
                        </select>
                    </div>

                    <div
                        id="product-grid"
                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
                    >
                        {
                            allUMKM.map((product, i) => (
                                <div
                                    class="product-item bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group opacity-0 animate-fade-in-up"
                                    data-category={product.data.category}
                                    data-price={product.data.price}
                                    data-name={product.data.name}
                                    style={`animation-delay: ${i * 80}ms`}
                                >
                                    <a
                                        href={`/belanja/${product.slug}`}
                                        class="block aspect-square overflow-hidden relative"
                                    >
                                        <img
                                            src={product.data.image}
                                            alt={product.data.name}
                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                            loading="lazy"
                                        />
                                        <div class="absolute top-4 right-4 px-3 py-1.5 bg-white/90 backdrop-blur-sm shadow-sm rounded-full text-[10px] font-bold text-primary-700 uppercase tracking-wider">
                                            {product.data.category}
                                        </div>
                                    </a>
                                    <div class="p-6">
                                        <a
                                            href={`/belanja/${product.slug}`}
                                            class="block"
                                        >
                                            <h3 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-primary-600 transition-colors line-clamp-1">
                                                {product.data.name}
                                            </h3>
                                        </a>
                                        <p class="text-xs text-slate-400 mb-4 flex items-center">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-3 w-3 mr-1.5 text-slate-300"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                                />
                                            </svg>
                                            {product.data.owner}
                                        </p>
                                        <div class="flex items-center justify-between">
                                            <span class="text-xl font-bold text-primary-600">
                                                Rp
                                                {product.data.price.toLocaleString(
                                                    "id-ID",
                                                )}
                                            </span>
                                            <a
                                                href={`/belanja/${product.slug}`}
                                                class="w-10 h-10 bg-primary-50 text-primary-600 rounded-xl flex items-center justify-center hover:bg-primary-600 hover:text-white transition-all group/btn"
                                                title="Lihat Detail"
                                            >
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-5 w-5 group-hover/btn:scale-110 transition-transform"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                                                    />
                                                </svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Empty State -->
                    <div id="empty-state" class="hidden py-20 text-center">
                        <div class="text-6xl mb-4">🔍</div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">
                            Produk Tidak Ditemukan
                        </h3>
                        <p class="text-slate-500 text-sm mb-6">
                            Coba ubah filter atau kategori yang dipilih.
                        </p>
                        <button
                            id="reset-filters"
                            class="px-6 py-2.5 bg-primary-600 text-white rounded-xl text-sm font-bold hover:bg-primary-700 transition-colors"
                        >
                            Reset Filter
                        </button>
                    </div>
                </div>
            </div>
        </Container>
    </section>
</MainLayout>

<style>
    @keyframes fade-in-up {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in-up {
        animation: fade-in-up 0.5s ease-out forwards;
    }

    @keyframes float-slow {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-12px);
        }
    }
    @keyframes float-medium {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-8px);
        }
    }
    @keyframes float-fast {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-16px);
        }
    }
    .animate-float-slow {
        animation: float-slow 6s ease-in-out infinite;
    }
    .animate-float-medium {
        animation: float-medium 4s ease-in-out infinite;
    }
    .animate-float-fast {
        animation: float-fast 5s ease-in-out infinite;
    }

    /* Custom range slider */
    input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        height: 20px;
        width: 20px;
        border-radius: 50%;
        background: var(--color-primary-600, #16a34a);
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
        border: 3px solid white;
    }

    /* Sidebar slide animation for mobile */
    #filter-sidebar.mobile-open {
        display: block;
        animation: slide-down 0.3s ease-out;
    }
    @keyframes slide-down {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const grid = document.getElementById("product-grid");
        const items = Array.from(document.querySelectorAll(".product-item"));
        const countEl = document.getElementById("product-count");
        const emptyState = document.getElementById("empty-state");
        const sortSelect = document.getElementById(
            "sort-select",
        ) as HTMLSelectElement;
        const priceRange = document.getElementById(
            "price-range",
        ) as HTMLInputElement;
        const priceDisplay = document.getElementById("price-display");
        const categoryBtns = document.querySelectorAll(".category-btn");
        const mobileToggle = document.getElementById("mobile-filter-toggle");
        const sidebar = document.getElementById("filter-sidebar");
        const resetBtn = document.getElementById("reset-filters");
        const filterBadge = document.getElementById("active-filter-badge");

        let activeCategory = "Semua";
        let maxPriceFilter = parseInt(priceRange?.value || "999999999");

        // === Category Filter ===
        categoryBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                activeCategory = btn.getAttribute("data-category") || "Semua";

                categoryBtns.forEach((b) => {
                    b.classList.remove(
                        "bg-primary-50",
                        "text-primary-700",
                        "font-bold",
                    );
                    b.classList.add("text-slate-600");
                });
                btn.classList.add(
                    "bg-primary-50",
                    "text-primary-700",
                    "font-bold",
                );
                btn.classList.remove("text-slate-600");

                applyFilters();
            });
        });

        // === Price Range ===
        if (priceRange) {
            priceRange.addEventListener("input", () => {
                maxPriceFilter = parseInt(priceRange.value);
                if (priceDisplay) {
                    priceDisplay.textContent = `Maks: Rp${maxPriceFilter.toLocaleString("id-ID")}`;
                }
                applyFilters();
            });
        }

        // === Sort ===
        if (sortSelect) {
            sortSelect.addEventListener("change", () => {
                applyFilters();
            });
        }

        // === Mobile Toggle ===
        if (mobileToggle && sidebar) {
            mobileToggle.addEventListener("click", () => {
                sidebar.classList.toggle("mobile-open");
                sidebar.classList.toggle("hidden");
            });
        }

        // === Reset Filters ===
        if (resetBtn) {
            resetBtn.addEventListener("click", () => {
                activeCategory = "Semua";
                if (priceRange) priceRange.value = priceRange.max;
                maxPriceFilter = parseInt(priceRange?.max || "999999999");
                if (priceDisplay) {
                    priceDisplay.textContent = `Maks: Rp${maxPriceFilter.toLocaleString("id-ID")}`;
                }
                categoryBtns.forEach((b, i) => {
                    b.classList.remove(
                        "bg-primary-50",
                        "text-primary-700",
                        "font-bold",
                    );
                    b.classList.add("text-slate-600");
                    if (i === 0) {
                        b.classList.add(
                            "bg-primary-50",
                            "text-primary-700",
                            "font-bold",
                        );
                        b.classList.remove("text-slate-600");
                    }
                });
                if (sortSelect) sortSelect.value = "default";
                applyFilters();
            });
        }

        // === Core Filter + Sort Logic ===
        function applyFilters() {
            const sortValue = sortSelect?.value || "default";

            // Filter
            let visible = items.filter((item) => {
                const cat = item.getAttribute("data-category") || "";
                const price = parseInt(item.getAttribute("data-price") || "0");
                const matchCategory =
                    activeCategory === "Semua" || cat === activeCategory;
                const matchPrice = price <= maxPriceFilter;
                return matchCategory && matchPrice;
            });

            // Sort
            if (sortValue === "price-asc") {
                visible.sort(
                    (a, b) =>
                        parseInt(a.getAttribute("data-price") || "0") -
                        parseInt(b.getAttribute("data-price") || "0"),
                );
            } else if (sortValue === "price-desc") {
                visible.sort(
                    (a, b) =>
                        parseInt(b.getAttribute("data-price") || "0") -
                        parseInt(a.getAttribute("data-price") || "0"),
                );
            } else if (sortValue === "name-asc") {
                visible.sort((a, b) =>
                    (a.getAttribute("data-name") || "").localeCompare(
                        b.getAttribute("data-name") || "",
                    ),
                );
            }

            // Apply visibility
            items.forEach((item) => {
                (item as HTMLElement).style.display = "none";
            });
            visible.forEach((item, i) => {
                const el = item as HTMLElement;
                el.style.display = "";
                el.style.order = String(i);
            });

            // Update count
            if (countEl) countEl.textContent = String(visible.length);

            // Empty state
            if (emptyState) {
                emptyState.classList.toggle("hidden", visible.length > 0);
            }
            if (grid) {
                grid.classList.toggle("hidden", visible.length === 0);
            }

            // Update filter badge for mobile
            let activeCount = 0;
            if (activeCategory !== "Semua") activeCount++;
            if (maxPriceFilter < parseInt(priceRange?.max || "999999999"))
                activeCount++;
            if (filterBadge) {
                filterBadge.classList.toggle("hidden", activeCount === 0);
                filterBadge.textContent = String(activeCount);
            }
        }
    });
</script>
