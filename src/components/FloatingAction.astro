---
export interface Props {
    phoneNumber?: string; // The target WhatsApp number
}

const { phoneNumber = "6281234567890" } = Astro.props;
---

<!-- Floating Action Buttons --><!-- Floating Action Buttons -->
<div
    class="fixed bottom-4 right-4 md:bottom-6 md:right-6 z-[60] flex flex-col md:flex-row items-end md:items-center space-y-3 md:space-y-0 md:space-x-3 pointer-events-none"
>
    <button
        class="pointer-events-auto w-12 h-12 bg-indigo-700 text-white rounded-full flex items-center justify-center shadow-lg hover:bg-indigo-800 hover:scale-105 transition-all outline-none"
        id="btn-accessibility"
        aria-label="Aksesibilitas"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            ></path>
        </svg>
    </button>
    <button
        class="pointer-events-auto px-5 h-12 bg-[#5DD26D] text-white font-bold rounded-full flex items-center shadow-lg hover:bg-[#4ebf5c] hover:scale-105 transition-all"
        id="btn-pengaduan"
        aria-label="Form Pengaduan"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
            ></path>
        </svg>
        Pengaduan
    </button>
</div>

<!-- Modal Overlay -->
<div
    id="pengaduan-modal"
    class="fixed inset-0 z-[70] bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center opacity-0 transition-opacity duration-300"
>
    <div
        class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 overflow-hidden transform scale-95 transition-transform duration-300 relative"
    >
        <!-- Close Button -->
        <button
            id="close-modal"
            class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-full p-2 transition-colors"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <!-- Header -->
        <div class="px-8 pt-8 pb-4">
            <h3 class="text-2xl font-bold text-slate-800">Form Pengaduan</h3>
            <p class="text-slate-500 text-sm mt-1">
                Sampaikan laporan atau aspirasi Anda secara langsung.
            </p>
        </div>

        <!-- Form Body -->
        <div class="px-8 pb-8">
            <form id="pengaduan-form" class="space-y-4">
                <div>
                    <label
                        class="block text-slate-800 font-bold mb-1.5 text-sm"
                        for="nama"
                        >Nama <span class="text-red-500">*</span></label
                    >
                    <input
                        type="text"
                        id="nama"
                        required
                        class="w-full bg-slate-100 border-none rounded-xl px-4 py-3 placeholder-slate-400 text-slate-700 outline-none focus:ring-2 focus:ring-[#5DD26D]/50 transition-shadow"
                        placeholder="Masukkan nama Anda"
                    />
                </div>

                <div>
                    <label
                        class="block text-slate-800 font-bold mb-1.5 text-sm"
                        for="telepon"
                        >Nomor Telepon/WA <span class="text-red-500">*</span
                        ></label
                    >
                    <input
                        type="tel"
                        id="telepon"
                        required
                        class="w-full bg-slate-100 border-none rounded-xl px-4 py-3 placeholder-slate-400 text-slate-700 outline-none focus:ring-2 focus:ring-[#5DD26D]/50 transition-shadow"
                        placeholder="Masukkan nomor HP/WhatsApp"
                    />
                </div>

                <div>
                    <label
                        class="block text-slate-800 font-bold mb-1.5 text-sm"
                        for="kategori"
                        >Kategori Pengaduan <span class="text-red-500">*</span
                        ></label
                    >
                    <div class="relative">
                        <select
                            id="kategori"
                            required
                            class="w-full bg-slate-100 border-none rounded-xl px-4 py-3 text-slate-700 outline-none focus:ring-2 focus:ring-[#5DD26D]/50 transition-shadow appearance-none cursor-pointer border border-transparent focus:border-[#5DD26D]"
                        >
                            <option
                                value=""
                                disabled
                                selected
                                class="text-slate-400"
                                >Pilih kategori pengaduan</option
                            >
                            <option value="Infrastruktur"
                                >Layanan Infrastruktur (Jalan, Jembatan)</option
                            >
                            <option value="Administrasi"
                                >Layanan Administrasi Desa (Surat, KTP)</option
                            >
                            <option value="Keamanan"
                                >Keamanan & Ketertiban</option
                            >
                            <option value="Lingkungan"
                                >Lingkungan (Kebersihan, Sampah)</option
                            >
                            <option value="Lainnya"
                                >Lainnya / Aspirasi Umum</option
                            >
                        </select>
                        <div
                            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500"
                        >
                            <svg
                                class="h-4 w-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path></svg
                            >
                        </div>
                    </div>
                </div>

                <div>
                    <label
                        class="block text-slate-800 font-bold mb-1.5 text-sm"
                        for="pesan"
                        >Pengaduan <span class="text-red-500">*</span></label
                    >
                    <textarea
                        id="pesan"
                        required
                        rows="3"
                        class="w-full bg-slate-100 border-none rounded-xl px-4 py-3 placeholder-slate-400 text-slate-700 outline-none focus:ring-2 focus:ring-[#5DD26D]/50 transition-shadow resize-none"
                        placeholder="Masukkan kesan, informasi, atau detail aduan Anda"
                    ></textarea>
                </div>

                <!-- NOTE: File attachment in purely clinet-side WhatsApp links isn't possible directly. 
                     We can only hint to the user to send it after the chat opens. -->
                <div>
                    <label class="block text-slate-800 font-bold mb-1.5 text-sm"
                        >Lampiran</label
                    >
                    <div
                        class="w-full bg-slate-100 rounded-xl px-4 py-3 text-slate-500 flex items-center text-sm border border-slate-200"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 mr-2 text-slate-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"
                            ></path>
                        </svg>
                        <span class="italic text-xs"
                            >Silakan kirimkan foto/Pendaftaran langsung di
                            obrolan WhatsApp nanti.</span
                        >
                    </div>
                </div>

                <div class="pt-4 flex justify-end">
                    <button
                        type="submit"
                        class="bg-[#5DD26D] hover:bg-[#4ebf5c] text-white font-bold py-3 px-8 rounded-xl flex items-center transition-colors"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 mr-2 -ml-1"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                        Kirim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script define:vars={{ phoneNumber }}>
    const modal = document.getElementById("pengaduan-modal");
    const btnOpen = document.getElementById("btn-pengaduan");
    const btnClose = document.getElementById("close-modal");
    const form = document.getElementById("pengaduan-form");

    // Toggle Modal
    btnOpen.addEventListener("click", () => {
        modal.classList.remove("hidden");
        // Small delay to allow display:block to apply before animating opacity
        setTimeout(() => {
            modal.classList.remove("opacity-0");
            modal.children[0].classList.remove("scale-95");
        }, 10);
    });

    const closeModal = () => {
        modal.classList.add("opacity-0");
        modal.children[0].classList.add("scale-95");
        setTimeout(() => {
            modal.classList.add("hidden");
        }, 300); // match duration-300
    };

    btnClose.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
    });

    // Form Submission to WhatsApp
    form.addEventListener("submit", (e) => {
        e.preventDefault();

        const nama = document.getElementById("nama").value;
        const telp = document.getElementById("telepon").value;
        const kategori = document.getElementById("kategori").value;
        const pesan = document.getElementById("pesan").value;

        // Combine fields for the pengaduan page format
        const combinedPesan = `Kategori: ${kategori}\nNo. HP: ${telp}\n\n${pesan}`;

        // Save to localStorage so it can be picked up by the Pengaduan page
        localStorage.setItem(
            "pendingPengaduan",
            JSON.stringify({
                nama: nama,
                pesan: combinedPesan,
            }),
        );

        // Redirect to Pengaduan Page
        window.location.href = "/pengaduan";
    });
</script>
