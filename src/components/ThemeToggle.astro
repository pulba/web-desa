---
// ThemeToggle.astro
interface Props {
    className?: string;
}

const { className = "ml-2" } = Astro.props;
---

<button
    type="button"
    class={`theme-toggle text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white rounded-lg p-2.5 transition-colors focus:outline-none ${className}`}
    aria-label="Toggle Dark Mode"
>
    <svg
        class="theme-toggle-dark-icon hidden w-5 h-5"
        fill="currentColor"
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg"
    >
        <path
            d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
        ></path>
    </svg>
    <svg
        class="theme-toggle-light-icon hidden w-5 h-5"
        fill="currentColor"
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg"
    >
        <path
            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
    </svg>
</button>

<script>
    function initThemeToggles() {
        const themeToggles = document.querySelectorAll(".theme-toggle");

        themeToggles.forEach((btn) => {
            const themeToggleDarkIcon = btn.querySelector(
                ".theme-toggle-dark-icon",
            );
            const themeToggleLightIcon = btn.querySelector(
                ".theme-toggle-light-icon",
            );

            // Set initial icon based on root class
            if (document.documentElement.classList.contains("dark")) {
                themeToggleLightIcon?.classList.remove("hidden");
                themeToggleDarkIcon?.classList.add("hidden");
            } else {
                themeToggleDarkIcon?.classList.remove("hidden");
                themeToggleLightIcon?.classList.add("hidden");
            }

            // Attach event listener only once per button
            if (btn.hasAttribute("data-theme-initialized")) return;
            btn.setAttribute("data-theme-initialized", "true");

            btn.addEventListener("click", function () {
                // Toggle theme logic
                const isDark =
                    document.documentElement.classList.contains("dark");
                if (isDark) {
                    document.documentElement.classList.remove("dark");
                    localStorage.setItem("theme", "light");
                } else {
                    document.documentElement.classList.add("dark");
                    localStorage.setItem("theme", "dark");
                }

                // Update all icons to stay in sync
                const newIsDark = !isDark;
                document.querySelectorAll(".theme-toggle").forEach((t) => {
                    if (newIsDark) {
                        t.querySelector(
                            ".theme-toggle-light-icon",
                        )?.classList.remove("hidden");
                        t.querySelector(
                            ".theme-toggle-dark-icon",
                        )?.classList.add("hidden");
                    } else {
                        t.querySelector(
                            ".theme-toggle-dark-icon",
                        )?.classList.remove("hidden");
                        t.querySelector(
                            ".theme-toggle-light-icon",
                        )?.classList.add("hidden");
                    }
                });
            });
        });
    }

    // Run immediately on script execution (Astro modules are deferred by default)
    initThemeToggles();

    // Re-run on view transitions if enabled
    document.addEventListener("astro:page-load", initThemeToggles);
</script>
