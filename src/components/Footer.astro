---
import Container from "./Container.astro";
import { getEntry } from "astro:content";

const settingsEntry = await getEntry("settings", "main");
const settings = settingsEntry?.data;

const currentYear = new Date().getFullYear();
---

<footer
    class="bg-primary-900 dark:bg-primary-950 text-slate-300 dark:text-slate-400 pt-16 pb-8 transition-colors"
>
    <Container>
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16"
        >
            <!-- Info Desa -->
            <div class="space-y-6">
                <div class="flex items-center space-x-3">
                    {
                        settings?.logo ? (
                            <img
                                src={settings.logo}
                                alt={settings.siteName}
                                class="w-10 h-10 object-contain"
                            />
                        ) : (
                            <div class="w-10 h-10 bg-primary-600 rounded-lg flex items-center justify-center text-white font-bold text-xl">
                                {settings?.siteName?.[0] || "D"}
                            </div>
                        )
                    }
                    <span class="text-xl font-bold text-white"
                        >{settings?.siteName || "Desa Makmur"}</span
                    >
                </div>
                <p class="text-sm leading-relaxed">
                    Pusat layanan informasi dan pelayanan publik digital {
                        settings?.siteName || "Desa Makmur"
                    }. Berkomitmen untuk transparansi dan kemajuan bersama.
                </p>
                <div class="flex space-x-4">
                    {
                        settings?.social?.facebook && (
                            <a
                                href={settings.social.facebook}
                                class="w-10 h-10 bg-primary-800 dark:bg-primary-900/80 rounded-full flex items-center justify-center hover:bg-primary-600 dark:hover:bg-primary-500 hover:text-white transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                                </svg>
                            </a>
                        )
                    }
                    {
                        settings?.social?.instagram && (
                            <a
                                href={settings.social.instagram}
                                class="w-10 h-10 bg-primary-800 dark:bg-primary-900/80 rounded-full flex items-center justify-center hover:bg-primary-600 dark:hover:bg-primary-500 hover:text-white transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.332 3.608 1.308.975.975 1.245 2.242 1.308 3.607.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.063 1.365-.333 2.633-1.308 3.608-.975.975-2.242 1.245-3.607 1.308-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.063-2.633-.332-3.608-1.308-.975-.975-1.245-2.242-1.308-3.607-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.062-1.366.332-2.633 1.308-3.608.975-.975 2.242-1.245 3.607-1.308 1.266-.058 1.646-.07 4.85-.07zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.668-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                                </svg>
                            </a>
                        )
                    }
                    {
                        settings?.social?.youtube && (
                            <a
                                href={settings.social.youtube}
                                class="w-10 h-10 bg-primary-800 dark:bg-primary-900/80 rounded-full flex items-center justify-center hover:bg-primary-600 dark:hover:bg-primary-500 hover:text-white transition-colors"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                                </svg>
                            </a>
                        )
                    }
                </div>
            </div>

            <!-- Tautan Cepat -->
            <div>
                <h3
                    class="text-white dark:text-slate-200 font-bold mb-6 transition-colors"
                >
                    Tautan Cepat
                </h3>
                <ul class="space-y-4">
                    <li>
                        <a
                            href="/profil"
                            class="hover:text-primary-400 transition-colors"
                            >Profil Desa</a
                        >
                    </li>
                    <li>
                        <a
                            href="/berita"
                            class="hover:text-primary-400 transition-colors"
                            >Berita Desa</a
                        >
                    </li>
                    <li>
                        <a
                            href="/ppid"
                            class="hover:text-primary-400 transition-colors"
                            >PPID</a
                        >
                    </li>
                    <li>
                        <a
                            href="/infografis"
                            class="hover:text-primary-400 transition-colors"
                            >Infografis Desa</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Kontak -->
            <div>
                <h3
                    class="text-white dark:text-slate-200 font-bold mb-6 transition-colors"
                >
                    Kontak Kami
                </h3>
                <ul class="space-y-4 text-sm">
                    <li class="flex items-start space-x-3">
                        <svg
                            class="w-5 h-5 text-primary-500 shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            ></path><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                            ></path></svg
                        >
                        <span
                            >{
                                settings?.address ||
                                    "Jl. Raya Makmur No. 123, Kec. Sejahtera, Kab. Sejahtera, 12345"
                            }</span
                        >
                    </li>
                    <li class="flex items-center space-x-3">
                        <svg
                            class="w-5 h-5 text-primary-500 shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path></svg
                        >
                        <span>{settings?.phone || "(021) 12345678"}</span>
                    </li>
                    <li class="flex items-center space-x-3">
                        <svg
                            class="w-5 h-5 text-primary-500 shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path></svg
                        >
                        <span>{settings?.email || "info@desamakmur.go.id"}</span
                        >
                    </li>
                </ul>
            </div>

            <!-- Map Placeholder -->
            {
                settings?.googleMapsUrl && (
                    <div>
                        <h3 class="text-white dark:text-slate-200 font-bold mb-6 transition-colors">
                            Lokasi
                        </h3>
                        <div class="aspect-video bg-primary-800 rounded-lg overflow-hidden relative group">
                            <iframe
                                src={settings.googleMapsUrl}
                                width="100%"
                                height="100%"
                                class="absolute inset-0 border-0 opacity-70 group-hover:opacity-100 transition-opacity duration-300"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                            />
                        </div>
                    </div>
                )
            }
        </div>

        <!-- Copyright -->
        <div
            class="pt-8 border-t border-primary-800 dark:border-primary-800/50 text-center text-sm transition-colors"
        >
            <p>
                &copy; {currentYear} Pemerintah {
                    settings?.siteName || "Desa Makmur"
                }. All rights reserved.
            </p>
        </div>
    </Container>
</footer>
