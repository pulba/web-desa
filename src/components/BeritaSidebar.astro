---
import { getCollection } from "astro:content";
import { NEWS_CATEGORIES } from "../config/newsCategories";

const allBerita = await getCollection("berita");
const publishedBerita = allBerita.filter((berita) => {
    const data = berita.data as any;
    const isPublished = data.status === "Published";
    const isScheduledVisible =
        data.status === "Scheduled" && new Date(data.date) <= new Date();
    return isPublished || isScheduledVisible;
});
const recentBerita = publishedBerita
    .sort(
        (a, b) =>
            new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    )
    .slice(0, 5);

// Randomly select 5 items for "Popular" widget to simulate popularity
const popularBerita = [...publishedBerita]
    .sort(() => 0.5 - Math.random())
    .slice(0, 5);
---

<aside class="space-y-8">
    <!-- Recent Posts Widget -->
    <div
        class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 transition-colors"
    >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
            Berita Terbaru
        </h3>
        <div class="space-y-4">
            {
                recentBerita.map((item) => (
                    <a href={`/berita/${item.slug}`} class="flex gap-4 group">
                        <div class="w-20 h-20 flex-shrink-0 rounded-lg overflow-hidden bg-slate-100 dark:bg-slate-700">
                            <img
                                src={item.data.image}
                                alt={item.data.title}
                                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                            />
                        </div>
                        <div>
                            <span class="text-xs font-medium text-primary-600 dark:text-primary-400 block mb-1">
                                {new Date(item.data.date).toLocaleDateString(
                                    "id-ID",
                                    {
                                        day: "numeric",
                                        month: "short",
                                        year: "numeric",
                                    },
                                )}
                            </span>
                            <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 line-clamp-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                                {item.data.title}
                            </h4>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>

    <!-- Popular Posts Widget (Randomized for Static Site) -->
    <div
        class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 transition-colors"
    >
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
            Berita Terpopuler
        </h3>
        <div class="space-y-4">
            {
                popularBerita.map((item, index) => (
                    <a
                        href={`/berita/${item.slug}`}
                        class="flex gap-4 group items-center"
                    >
                        <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 font-bold text-sm group-hover:bg-primary-600 group-hover:text-white transition-colors">
                            {index + 1}
                        </div>
                        <div>
                            <h4 class="text-sm font-medium text-slate-700 dark:text-slate-300 line-clamp-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                                {item.data.title}
                            </h4>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</aside>
